{
    "$schema": "https://getcomposer.org/schema.json",
    "version": "1.1.3",
    "name": "haitham-maznai/form-stepper",
    "description": "Persistent, option-driven single-step and stepper forms for Laravel with requester and optional tenant ownership.",
    "keywords": [
        "laravel",
        "haitham-maznai",
        "form-stepper"
    ],
    "homepage": "https://github.com/HaithamMaznai7/FormStepper",
    "license": "MIT",
    "authors": [
        {
            "name": "Haitham Maznai",
            "email": "haitham@fahis.sa",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^10.48.29||^11.0||^12.0||^13.0",
        "illuminate/http": "^10.48.29||^11.0||^12.0||^13.0",
        "illuminate/routing": "^10.48.29||^11.0||^12.0||^13.0",
        "illuminate/support": "^10.48.29||^11.0||^12.0||^13.0",
        "illuminate/validation": "^10.48.29||^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "doctrine/dbal": "3.9",
        "larastan/larastan": "^2.11.2||^3.9",
        "laravel/framework": "10.48.29",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "8.22.3",
        "pestphp/pest": "^2.34.7||^3.8||^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^2.4||^3.2||^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^2.8||^3.5||^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "HaithamMaznai\\FormStepper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HaithamMaznai\\FormStepper\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "@php -d memory_limit=512M vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "@php -d memory_limit=512M vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "HaithamMaznai\\FormStepper\\FormStepperServiceProvider"
            ],
            "aliases": {
                "FormStepper": "HaithamMaznai\\FormStepper\\Facades\\FormStepper"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "vendor-dir": "build/compat10/vendor",
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
